.fvec projection[4], modelView[4]
.constf constants(0.0, 1.0, 0.00392156862745, 0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0
.in position v0
.in color v1
.in texcoord v2
.proc main
    mov r0.xyz, position
    mov r0.w, constants.y
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    mul outcolor, constants.zzzz, color
    mov outuv, texcoord
    end
.end
