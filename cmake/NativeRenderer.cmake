    # Upstream C: definitions without the prototypes of the public headers,
    # and its signed stencil-mask shift, both kept as published.
    set_source_files_properties("${NATIVE_STATE_ORACLE}" PROPERTIES COMPILE_OPTIONS
      "-Wno-missing-prototypes;-Wno-strict-prototypes;-fno-sanitize=shift-base;-fno-sanitize=shift;$<$<C_COMPILER_ID:Clang,AppleClang>:-Wno-sizeof-array-div>")
    list(APPEND NATIVE_STATE_ORACLES "${NATIVE_STATE_ORACLE}")
